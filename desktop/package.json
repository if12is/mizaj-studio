{
  "name": "mizaj-desktop",
  "version": "0.1.0",
  "description": "Mizaj Studio desktop app",
  "private": true,
  "license": "GPL-3.0-or-later",
  "main": "./out/main/index.js",
  "engines": {
    "node": ">=20.11.0"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:web": "vue-tsc --noEmit -p tsconfig.web.json",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test:unit": "vitest run",
    "dist:win": "electron-vite build && electron-builder --win --publish never",
    "dist:mac": "electron-vite build && electron-builder --mac --publish never",
    "dist:linux": "electron-vite build && electron-builder --linux --publish never",
    "release": "electron-vite build && electron-builder --publish always",
    "test:e2e": "electron-vite build && xvfb-run -a playwright test"
  },
  "dependencies": {
    "@codemirror/commands": "6.5.0",
    "@codemirror/merge": "6.6.1",
    "@codemirror/state": "6.4.1",
    "@codemirror/view": "6.26.3",
    "@fontsource/amiri": "5.0.8",
    "@fontsource/cairo": "5.0.17",
    "electron-log": "5.1.2",
    "pinia": "2.1.7",
    "vue": "3.4.27"
  },
  "devDependencies": {
    "@playwright/test": "1.47.2",
    "@types/node": "20.14.2",
    "@typescript-eslint/eslint-plugin": "7.13.0",
    "@typescript-eslint/parser": "7.13.0",
    "@vitejs/plugin-vue": "5.0.4",
    "autoprefixer": "10.4.19",
    "electron": "31.0.2",
    "electron-builder": "24.13.3",
    "electron-vite": "2.3.0",
    "eslint": "8.57.0",
    "eslint-config-prettier": "9.1.0",
    "eslint-plugin-vue": "9.26.0",
    "postcss": "8.4.38",
    "prettier": "3.3.2",
    "tailwindcss": "3.4.4",
    "typescript": "5.4.5",
    "vite": "5.2.13",
    "vitest": "1.6.0",
    "vue-eslint-parser": "9.4.3",
    "vue-tsc": "2.0.21"
  },
  "overrides": {
    "@volar/language-core": "2.2.4",
    "@volar/source-map": "2.2.4",
    "@volar/typescript": "2.2.4"
  },
  "author": "Mizaj Studio",
  "homepage": "https://github.com/if12is/mizaj-studio"
}
